{
  "name": "opennote-electron",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run build:patches && concurrently \"bun run dev:expo\" \"bun run dev:electron\"",
    "dev:expo": "cd expo-patched && bun install && bun run dev:web",
    "dev:electron": "wait-on http://localhost:8081 && electron .",
    "fix": "oxfmt -c config/oxfmt.json && oxlint -c config/oxlint.json --fix && tsc --noEmit",
    "build": "bun run build:patches && bun run export:expo && bun run build:electron && electron-builder",
    "build:patches": "bun scripts/patch.ts",
    "build:electron": "tsc",
    "export:expo": "cd expo-patched && bun install && bun run export:web",
    "package": "bun run build"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "concurrently": "^9.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.59.0",
    "typescript": "~5.9.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "click.opennote.opennote",
    "productName": "open[note]",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "expo-patched/dist",
        "to": "expo-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
