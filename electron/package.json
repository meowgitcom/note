{
  "name": "electron",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run build:patches && bun run build:electron && concurrently \"bun run dev:watch\" \"bun run dev:expo\" \"bun run dev:electron\"",
    "dev:watch": "bun scripts/watch.ts",
    "dev:expo": "cd expo-patched && BROWSER=none ./node_modules/.bin/expo start --web",
    "dev:electron": "wait-on http://localhost:8081 && electron .",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "fix": "oxfmt -c ../config/oxfmt.json && oxlint -c ../config/oxlint.json --fix && tsc --noEmit",
    "build": "bun run build:patches && bun run export:expo && bun run build:electron && electron-builder",
    "build:patches": "bun scripts/patch.ts",
    "build:electron": "tsc",
    "export:expo": "cd expo-patched && ./node_modules/.bin/expo export --platform web",
    "package": "bun run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "electron": "^41.1.1",
    "electron-builder": "^24.13.3",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.59.0",
    "typescript": "~5.9.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.meowgit.meownote",
    "productName": "meow[note]",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "drizzle/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "expo-patched/dist",
        "to": "expo-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
