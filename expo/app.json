{
  "expo": {
    "name": "meow[note]",
    "slug": "meownote",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "meownote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meowgit.meownote"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.meowgit.meownote"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-font", "expo-router"]
  }
}
