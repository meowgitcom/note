{
  "name": "expo",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "expo start --web",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "fix": "oxfmt -c ../config/oxfmt.json && oxlint -c ../config/oxlint.json --fix && tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.33",
    "expo-font": "~14.0.11",
    "expo-router": "~6.0.23",
    "expo-sqlite": "~16.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.5",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "~5.9.3"
  }
}
