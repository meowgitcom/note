{
  "name": "api",
  "private": true,
  "type": "module",
  "module": "app.ts",
  "scripts": {
    "gen:routes": "bun scripts/routes.ts",
    "watch:routes": "bun scripts/routes.ts --watch",
    "dev": "bun gen:routes && bun dev.ts",
    "deploy:cf": "bun gen:routes && wrangler deploy",
    "dev:cf": "bun gen:routes && wrangler dev",
    "fix": "oxfmt -c ../config/oxfmt.json && oxlint -c ../config/oxlint.json --fix && tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "elysia": "^1.4.28",
    "env": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "wrangler": "^4.20.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
