    "env": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.5",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
